generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WeekPlan {
  id            String    @id @default(cuid())
  weekStartDate DateTime  // Monday of the week
  createdAt     DateTime  @default(now())
  rows          PlanRow[]
}

model PlanRow {
  id           String     @id @default(cuid())
  weekPlanId   String
  weekPlan     WeekPlan   @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  day          String     // Monday, Tuesday, etc.
  type         String     // Gym, Run, Circuit, Activity
  notes        String
  exercise     String     // Exercise / Activity name
  setsText     String     // e.g., "4" or "3-4"
  repsTimeText String     // e.g., "8-12" or "30 min"
  sortOrder    Int
  logEntries   LogEntry[]
}

model LogEntry {
  id                 String   @id @default(cuid())
  date               DateTime
  type               String   // Gym, Run, Circuit, Activity
  exerciseOrActivity String
  setsCompleted      Int?
  reps               Int?
  weight             Float?   // Weight in kg
  km                 Float?
  durationMin        Float?   // moving time in minutes
  circuitsCompleted  Int?
  xp                 Int      // Always stored, never recomputed
  notes              String?
  linkedPlanRowId    String?
  linkedPlanRow      PlanRow? @relation(fields: [linkedPlanRowId], references: [id], onDelete: SetNull)
  stravaActivityId   String?  @unique // Strava activity id when imported via sync
  // JSON blob from the Strava detail fetch:
  // { movingTimeSec, avgPaceSecPerKm, splitsSecPerKm: number[], paceCV,
  //   paceDriftPct, avgHr, elevationM } — fields optional/null when unknown.
  // Non-runs store just { movingTimeSec }.
  stravaData         String?
  createdAt          DateTime @default(now())
}

// Simple key/value store (Strava tokens + sync bookkeeping).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
